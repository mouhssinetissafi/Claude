# Copy to .env and `source`/export these, or set them in your shell. Never commit real keys.

# Anthropic (vision analysis + script writing). Alternative: run `ant auth login`.
ANTHROPIC_API_KEY=

# ElevenLabs text-to-speech (normal + footage-only narration)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: stock footage for normal mode
PEXELS_API_KEY=

# Optional: YouTube upload (only used with --upload and upload.enabled: true)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional: point Remotion at a specific Chrome/Chromium binary
REMOTION_BROWSER=

# Set to 1 to force offline mock providers (tests/CI); same as --mock
AUTOEDITOR_MOCK=
